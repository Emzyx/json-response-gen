{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "target": "ES2020",
    "moduleResolution": "Node",
    "module": "CommonJS",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "dist",
    "removeComments": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "cli.js"],
  "exclude": ["node_modules", "dist"]
}
